; GX vertex shader (platform/3ds/pica/pica_draw.c), two modes chosen by the `cpu` bool.
;
; cpu = true: the CPU has already applied the GameCube's position matrix, projection and
;   viewport. v0 is a homogeneous position in EFB pixels with the GameCube depth in z, v1-v3 the
;   texture coordinates of units 0-2, v4 a 0..255 colour. F is the EFB-pixels -> PICA projection.
;   pj: unit 0's coordinate is projective, (s q, t q) in v1 with q in v3.x, which goes out as
;   texcoord0w for a texture unit 0 in projection mode (the divide by q per pixel); else 1.
;
; cpu = false: GameCube vertices as the GX front half decoded them, transformed here.
;   v0 position (x, y, z), v1 normal, v2 the colour channel's colour (0..255), v3-v5 up to three
;   texture coordinate attributes (s, t), v6 the position matrix row index (GX PNMTX: 0, 3, ..27).
;   P: position matrix rows 0-29 (XF memory words 0-119). N[3k]: matrix k's light vector (the
;   CPU's: the light direction LD taken into model space through normal matrix k, divided by its
;   scale, times 0.65 LD.w), so N[3k] . normal is 0.65 LD.w (N.LD)/|N| for the unit model normals
;   of models scaled alike on every axis; N[3k+1], N[3k+2] are unused.
;   F: view space -> clip (GX projection, viewport and the PICA projection, composed on the CPU).
;   Texture unit u: source = W[2u].x pos + W[2u].y normal + W[2u].z v3 + W[2u].w v4 + W[2u+1].x v5,
;   coordinate = (T[2u] . source, T[2u+1] . source) (texgen, texture/post matrix, EFB copy rect).
;   Colour = v2 / 255 * CS + CM, rgb times the shade 1 + LD.w * (0.35 + 0.65 max(N.LD, 0) - 1),
;   computed as LD.x + max(N[idx] . normal, 0) with LD.x = 1 - 0.65 LD.w (one dp3: the normal's
;   transform, its normalisation and the shade's 17 dependent instructions cost the GPU ~14 ns an
;   index, as much as the rest of the shader).
;   Per draw, work that would not change the result is skipped (most of the shader's cost): lit
;   (the shade, else 1), tuN (texture unit N is used, else its coordinate is 0) and tdN (unit N's
;   source is exactly attribute v(3+N), so the coordinate is (T[2N] . v, T[2N+1] . v)).

.fvec F[4]
.fvec P[30]
.fvec N[30]
.fvec T[6]
.fvec W[6]
.fvec CS
.fvec CM
.fvec LD
.bool cpu
.bool lit
.bool tu0
.bool tu1
.bool tu2
.bool td0
.bool td1
.bool td2
.bool pj

.constf k0(1.0, 0.0, 0.35, 0.65)
.constf k1(0.00392156862745098, 1e-20, 0.0, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outtc0w texcoord0w
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color

.proc main
	ifu cpu
		dp4 outpos.x, F[0], v0
		dp4 outpos.y, F[1], v0
		dp4 outpos.z, F[2], v0
		dp4 outpos.w, F[3], v0
		mov outtc0, v1
		mov outtc1, v2
		mov outtc2, v3
		mul outclr, k1.xxxx, v4
		ifu pj
			mov outtc0w, v3.x
		.else
			mov outtc0w, k0.x
		.end
	.else
		mov outtc0w, k0.x
		; position: view = P[idx..idx+2] . (pos, 1); clip = F . view
		mova a0.x, v6.x
		mov r0.xyz, v0
		mov r0.w, k0.x
		dp4 r1.x, P[a0.x], r0
		dp4 r1.y, P[a0.x+1], r0
		dp4 r1.z, P[a0.x+2], r0
		mov r1.w, k0.x
		dp4 outpos.x, F[0], r1
		dp4 outpos.y, F[1], r1
		dp4 outpos.z, F[2], r1
		dp4 outpos.w, F[3], r1

		; colour
		mul r5, k1.xxxx, v2
		mul r5, CS, r5
		add r5, CM, r5

		; shade from the view-space normal (one fixed light, as the CPU path)
		ifu lit
			dp3 r4.y, N[a0.x], v1
			max r4.y, k0.yyyy, r4.y
			add r4.y, LD.xxxx, r4.y
			mul r5.xyz, r4.yyy, r5.xyz
		.end
		mov outclr, r5

		; texture sources: r0 = (pos, 1), r6 = (normal, 1)
		; On a New 3DS the GPU locked up (never finished the frame) when this section used mad and
		; wrote outtcN.x and .y with separate dp4s; Azahar ran it. Plain mul/add, and each coordinate
		; built in r9 and written whole, as the rest of the shader does.
		mov r6.xyz, v1
		mov r6.w, k0.x

		mov r9, k0.yyyy
		ifu tu0
			ifu td0
				dp4 r9.x, T[0], v3
				dp4 r9.y, T[1], v3
			.else
				mul r7, W[0].xxxx, r0
				mul r8, W[0].yyyy, r6
				add r7, r7, r8
				mul r8, W[0].zzzz, v3
				add r7, r7, r8
				mul r8, W[0].wwww, v4
				add r7, r7, r8
				mul r8, W[1].xxxx, v5
				add r7, r7, r8
				dp4 r9.x, T[0], r7
				dp4 r9.y, T[1], r7
			.end
		.end
		mov outtc0, r9

		mov r9, k0.yyyy
		ifu tu1
			ifu td1
				dp4 r9.x, T[2], v4
				dp4 r9.y, T[3], v4
			.else
				mul r7, W[2].xxxx, r0
				mul r8, W[2].yyyy, r6
				add r7, r7, r8
				mul r8, W[2].zzzz, v3
				add r7, r7, r8
				mul r8, W[2].wwww, v4
				add r7, r7, r8
				mul r8, W[3].xxxx, v5
				add r7, r7, r8
				dp4 r9.x, T[2], r7
				dp4 r9.y, T[3], r7
			.end
		.end
		mov outtc1, r9

		mov r9, k0.yyyy
		ifu tu2
			ifu td2
				dp4 r9.x, T[4], v5
				dp4 r9.y, T[5], v5
			.else
				mul r7, W[4].xxxx, r0
				mul r8, W[4].yyyy, r6
				add r7, r7, r8
				mul r8, W[4].zzzz, v3
				add r7, r7, r8
				mul r8, W[4].wwww, v4
				add r7, r7, r8
				mul r8, W[5].xxxx, v5
				add r7, r7, r8
				dp4 r9.x, T[4], r7
				dp4 r9.y, T[5], r7
			.end
		.end
		mov outtc2, r9
	.end
	end
.end
