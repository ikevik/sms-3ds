--- a/platform/gx/src/gx_api.cpp
+++ b/platform/gx/src/gx_api.cpp
@@ -2585,8 +2585,18 @@
     u32 n = pixMetricRead();
     *topIn = *botIn = *clrIn = n;
     *topOut = *botOut = *copyClks = 0;
+}
+#if defined(__3DS__)
+// 3DS port: the clear goes down the command stream (BP 0x57, as the SDK's), so the renderer starts
+// counting where the game asked, between the draws (on the GX thread). Each write differs (the
+// redundant-write filter would drop a repeat).
+void GXClearPixMetric(void) {
+    static uint32_t seq;
+    apiBP(0x57, ++seq & 0xFFFFFF);
 }
+#else
 void GXClearPixMetric(void) { pixMetricClear(); }
+#endif
 void GXSetVCacheMetric(GXVCachePerf) {}
 void GXReadVCacheMetric(u32* a, u32* b, u32* c) { *a = *b = *c = 0; }
 void GXClearVCacheMetric(void) {}
