+static void dlReplayOp(const DlEntry& e, const StateOp& s) {
+    switch (s.type) {
+    case 0x08:
+#if defined(__3DS__)
+        if (wrStudy()) wrCountCP(1, s.reg, s.v);
+#endif
+        writeCP(s.reg, s.v);
+        break;
+    case 0x61:
+#if defined(__3DS__)
+        if (wrStudy()) wrCountBP(1, s.v);
+#endif
+        writeBP(s.v);
+        break;
+    case 0x10:
+#if defined(__3DS__)
+        if (wrStudy()) wrCountXF(1, s.a, &e.words[s.v], s.n);
+#endif
+        for (uint32_t i = 0; i < s.n;) {  // as parse: at most 64 words per writeXF
+            uint32_t m = s.n - i > 64 ? 64 : s.n - i;
+            writeXF(uint16_t(s.a + i), m, &e.words[s.v + i]);
+            i += m;
+        }
+        break;
+    case 0x40: {
+        const uint8_t* dl = static_cast<const uint8_t*>(physToPtr(s.n));
+        if (s_dlDepth < 4 && dl && nestedListOk(dl, s.v)) {
+            s_dlDepth++;
+            runCommands(dl, s.v);
+            s_dlDepth--;
+        }
+        break;
+    }
+    default: loadIndexedXF(s.type, s.a, s.v); break;
+    }
+}
