+// A fast op's write when its register holds another value: as the command it came from.
+static void dlFastWrite(uint32_t* r, uint32_t v) {
+    const uintptr_t a = reinterpret_cast<uintptr_t>(r);
+    const auto at = [a](const uint32_t* base) { return uint32_t((a - reinterpret_cast<uintptr_t>(base)) / 4); };
+    if (at(g.bp) < 256) writeBP(at(g.bp) << 24 | v);
+    else if (at(g.kreg) < 8) writeBP((BP_TEV_REG + at(g.kreg)) << 24 | v);
+    else if (at(g.xfMem) < XF_MEM_WORDS) writeXF(uint16_t(at(g.xfMem)), 1, &v);
+    else if (at(g.xfReg) < XF_REG_COUNT) writeXF(uint16_t(XF_REG_BASE + at(g.xfReg)), 1, &v);
+    else if (at(g.arrayStride) < 16) writeCP(uint8_t(CP_ARRAY_STRIDE | at(g.arrayStride)), v);
+    else *r = v;  // vertex formats and matrix indices: writeCP only stores them
+}
