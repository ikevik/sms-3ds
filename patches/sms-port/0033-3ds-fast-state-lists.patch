+// Puts a state-only list's ops as register words (e.fast), each write exactly what writeBP,
+// writeCP or writeXF would do with an unchanged value: nothing. Left empty for a list with a BP
+// mask (the write after it merges), a draw-sync token or EFB copy (they run game code or much of
+// the back end), or a call to another list.
+static void dlCompileFast(DlEntry& e) {
+    std::vector<FastOp> f;
+    for (size_t i = 0; i < e.ops.size(); i++) {
+        const StateOp& s = e.ops[i];
+        if (s.type == 0x61) {
+            const uint32_t reg = s.v >> 24, data = s.v & 0xFFFFFF;
+            if (reg == BP_MASK || reg == BP_PE_TOKEN_INT || reg == BP_COPY_EXEC) return;
+            if (reg >= BP_TEV_REG && reg < BP_TEV_REG + 8 && (data & 0x800000)) {
+                f.push_back({&g.kreg[reg & 7], data});
+                continue;
+            }
+            const bool texImage = (reg >= BP_TX_IMAGE3 && reg < BP_TX_IMAGE3 + 4) ||
+                                  (reg >= BP_TX_IMAGE3 + 0x20 && reg < BP_TX_IMAGE3 + 0x24);
+            if (reg != BP_PE_TOKEN && reg != BP_DRAWDONE && reg != BP_LOADTLUT1 && reg != BP_TEXINVALIDATE &&
+                reg != BP_COPY_DST && !texImage) {  // these always do something
+                f.push_back({&g.bp[reg], data});
+                continue;
+            }
+        } else if (s.type == 0x08) {
+            uint32_t* r = nullptr;
+            uint32_t v = s.v;
+            switch (s.reg & 0xF0) {  // as writeCP
+            case CP_MATIDX_A: r = &g.cpMatA; break;
+            case CP_MATIDX_B: r = &g.cpMatB; break;
+            case CP_VCD_LO: r = &g.cpVcdLo; break;
+            case CP_VCD_HI: r = &g.cpVcdHi; break;
+            case CP_VAT_A: r = &g.cpVatA[s.reg & 7]; break;
+            case CP_VAT_B: r = &g.cpVatB[s.reg & 7]; break;
+            case CP_VAT_C: r = &g.cpVatC[s.reg & 7]; break;
+            case CP_ARRAY_STRIDE:
+                r = &g.arrayStride[s.reg & 15];
+                v &= 0xFF;
+                break;
+            case CP_ARRAY_BASE: break;
+            default: continue;  // a register writeCP ignores
+            }
+            if (r) {
+                f.push_back({r, v});
+                continue;
+            }
+        } else if (s.type == 0x10) {
+            for (uint32_t k = 0; k < s.n; k++) {
+                const uint16_t a = uint16_t(s.a + k);
+                if (a < XF_MEM_WORDS) f.push_back({&g.xfMem[a], e.words[s.v + k]});
+                else if (a >= XF_REG_BASE && a < XF_REG_BASE + XF_REG_COUNT)
+                    f.push_back({&g.xfReg[a - XF_REG_BASE], e.words[s.v + k]});
+            }
+            continue;
+        } else if (s.type == 0x40) {
+            return;
+        }
+        f.push_back({nullptr, uint32_t(i)});
+    }
+    e.fast.swap(f);
+}
