+static void creditGxTime() {
+    if (!GXPC_Detail) {
+        s_creditT = 0;
+        return;
+    }
+    const uint64_t now = svcGetSystemTick(), w = GX3DS_GxWaitTicks;
+    if (s_creditT) {
+        const int64_t t = int64_t(now - s_creditT) - int64_t(w - s_creditW);
+        if (t > 0) SMS3DS_ProfGxTicks(GXPC_ProfObj, s_origin, uint32_t(t));
+    }
+    s_creditT = now;
+    s_creditW = w;
+}
