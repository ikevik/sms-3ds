+namespace gx {
 // Streamed GX: settings the GX thread reads go through the stream, in order with the draws.
 static void streamOp(uint8_t op, const uint8_t* args, uint32_t n) {
+    // 3DS port: the op and its arguments straight into the buffer when they fit (nearly always):
+    // the same bytes, without two pipePut calls and a memcpy of one byte (the game thread sends
+    // thousands a frame: list calls, texture images).
+    if (g_gxStream && !s_mute && s_pipeLen + 1 + n <= GXPC_PipeFast) {
+        uint8_t* p = s_pipeBuf + s_pipeLen;
+        p[0] = op;
+        if (n <= 8) {
+            for (uint32_t i = 0; i < n; i++) p[1 + i] = args[i];
+        } else {
+            memcpy(p + 1, args, n);
+        }
+        s_pipeLen += 1 + n;
+        GXPC_StreamPuts += n ? 2 : 1;  // (as the two pipePut calls count)
+        // While the GX thread waits for work (each frame's start, where the game's first draws
+        // come slowly and an 8 KB chunk took ~2 ms to fill, on the frame's critical path in
+        // Azahar), what is here goes to it at once: the same commands, handed over sooner.
+        if (GXPC_GxIdle && s_pipeLen >= 512) streamSwap();
+        return;
+    }
     pipePut(&op, 1);
     if (n) pipePut(args, n);
 }
