+    memcpy(lo, r.verts.data(), 12);
+    memcpy(hi, lo, 12);
+    for (uint32_t i = 1; i < r.nverts; i++) {
+        float p[3];
+        memcpy(p, r.verts.data() + size_t(i) * r.stride, 12);
+        for (int k = 0; k < 3; k++) {
+            if (p[k] < lo[k]) lo[k] = p[k];
+            if (p[k] > hi[k]) hi[k] = p[k];
+        }
+    }
+    for (int k = 0; k < 3; k++)
+        if (!isfinite(lo[k]) || !isfinite(hi[k])) return;
