+// Sample arguments: each pointer gets a slot of its own in the pool (a few matrices
+// of a rotation with a translation), index arrays are zeros, scalars differ.
+static f32 s_bPool[6][64];
+static const u16 s_bIdx[16] = {};
+static int s_bSlot, s_bScalar;
+static volatile f32 s_bSink;
+template <typename T> struct BArg;
+template <typename T> struct BArg<T*> {
+	static T* get() { return (T*)(void*)s_bPool[s_bSlot++ % 6]; }
+};
+template <> struct BArg<const u16*> {
+	static const u16* get() { return s_bIdx; }
+};
+template <> struct BArg<f32> {
+	static f32 get() { return 0.25f * (f32)(++s_bScalar); }
+};
+template <> struct BArg<char> {
+	static char get() { return 'y'; }
+};
+template <> struct BArg<u32> {
+	static u32 get() { return 4; }
+};
+template <typename R> struct BRun {
+	template <typename F> static void run(F f) { s_bSink = (f32)f(); }
+};
+template <> struct BRun<void> {
+	template <typename F> static void run(F f) { f(); }
+};
+template <typename R, typename... A> static void mtx_benchCall(R (*fn)(A...))
+{
+	s_bSlot = s_bScalar = 0;
+	BRun<R>::run([&] { return fn(BArg<A>::get()...); });
+}
+
+// Runs routine i n times on fresh sample data.
+extern "C" void sms_mtx_bench(int i, int n)
+{
+	static const f32 m[12] = { 0.8f, -0.36f, 0.48f, 12.5f, 0.6f, 0.48f, -0.64f, -3.25f, 0.0f, 0.8f, 0.6f, 7.75f };
+	if (i < 0 || i >= sms_mtx_n || !s_mtxBench[i])
+		return;
+	for (int k = 0; k < 6 * 64; k++)
+		s_bPool[k / 64][k % 64] = m[k % 12];
+	while (n-- > 0)
+		s_mtxBench[i]();
+}
