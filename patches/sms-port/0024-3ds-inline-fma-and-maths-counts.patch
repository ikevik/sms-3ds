+/* 3DS port: 32-bit ARM without an FMA instruction (the 3DS's VFPv2). newlib's
+ * fmaf there is (float)((double)a * c + b) and its fma is a * c + b, unfused,
+ * each a library call (321 call sites in the MTX/VEC routines and MSL's
+ * maths). These are the same operations inline: the same bits, no call.
+ * fmaf's sum rounds twice, so it differs from the Gekko's single rounding
+ * where port_fmas_soft's check fires, as it did before. */
+#if defined(__arm__) && !defined(__aarch64__) && !defined(__ARM_FEATURE_FMA)
+#define PORT_FMA_VFP 1
+static inline float port_fmaf_vfp(float a, float c, float b) { return (float)((double)a * c + b); }
+static inline double port_fma_vfp(double a, double c, double b) { return a * c + b; }
+#endif
+
 #if defined(__x86_64__) || defined(__i386__)
 #define PORT_OPAQUE(x) __asm__("" : "+x"(x))
 #elif defined(__aarch64__)
 #define PORT_OPAQUE(x) __asm__("" : "+w"(x))
+#elif defined(__arm__) && defined(__ARM_FP)
+/* 3DS port: in a VFP register ("t" single, "w" double), not through memory
+ * ("+m" stored and reloaded the value at every negated multiply-add). */
+#ifdef __cplusplus
+static inline void port_opaque_vfp(float& x) { __asm__("" : "+t"(x)); }
+static inline void port_opaque_vfp(double& x) { __asm__("" : "+w"(x)); }
+#define PORT_OPAQUE(x) port_opaque_vfp(x)
 #else
+static inline void port_opaque_vfp_f(float* x) { __asm__("" : "+t"(*x)); }
+static inline void port_opaque_vfp_d(double* x) { __asm__("" : "+w"(*x)); }
+#define PORT_OPAQUE(x) _Generic((x), float: port_opaque_vfp_f, double: port_opaque_vfp_d)(&(x))
+#endif
+#else
 #define PORT_OPAQUE(x) __asm__("" : "+m"(x))
 #endif
 
