+	{                                                                            \
+		sms_mtx_calls[i]++;                                                      \
+		return (ret)CALL(fn, args);                                              \
+	}                                                                            \
+	static void bench_##fn() { mtx_benchCall(&name); }                           \
+	static const int reg_##fn = mtx_reg(i, #name, bench_##fn);
+#else
