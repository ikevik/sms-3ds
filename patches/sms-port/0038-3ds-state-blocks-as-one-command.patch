+// State blocks as one command (gx_api.cpp, GXPC_StateBlock): each block's registers, by id, as its
+// kStreamOpBlockDef gave them; a kStreamOpBlock writes them in that order with its values through
+// writeBP/writeCP/writeXF, leaving out a BP value already held (writeCP and writeXF change nothing
+// for one): the registers end as the block's separate (filtered) writes would have left them. GXPC_BlockOps: blocks written, and
+// written with a BP mask pending (its first BP write takes the mask, as a separate write would).
+extern "C" uint32_t GXPC_BlockOps[2];
+uint32_t GXPC_BlockOps[2];
+namespace {
+struct BlockDef {
+    std::vector<uint8_t> kind;
+    std::vector<uint16_t> reg;
+};
+std::vector<BlockDef> s_blockDefs;
+}  // namespace
+static void blockDef(const uint8_t* p) {
+    const uint32_t id = uint32_t(p[1]) << 8 | p[2], n = uint32_t(p[3]) << 8 | p[4];
+    if (id >= s_blockDefs.size()) s_blockDefs.resize(id + 1);
+    BlockDef& d = s_blockDefs[id];
+    d.kind.resize(n);
+    d.reg.resize(n);
+    for (uint32_t i = 0; i < n; i++) {
+        d.kind[i] = p[5 + 3 * i];
+        d.reg[i] = uint16_t(uint32_t(p[6 + 3 * i]) << 8 | p[7 + 3 * i]);
+    }
 }
+static void blockWrite(const uint8_t* p) {
+    const uint32_t id = uint32_t(p[1]) << 8 | p[2], n = uint32_t(p[3]) << 8 | p[4];
+    if (id >= s_blockDefs.size() || s_blockDefs[id].kind.size() != n) {
+        logmsg("state block %u written before its registers were given", unsigned(id));
+        return;
+    }
+    const BlockDef& d = s_blockDefs[id];
+    GXPC_BlockOps[0]++;
+    if (g.bpMask != 0xFFFFFF) GXPC_BlockOps[1]++;
+    const uint8_t* v = p + 5;
+    for (uint32_t i = 0; i < n; i++, v += 4) {
+        uint32_t w;
+        memcpy(&w, v, 4);
