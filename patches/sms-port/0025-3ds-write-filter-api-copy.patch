+// as commands, geometry drawn wrong: Delfino Plaza, from build 9b67851).
+extern "C" void GXPC_LoadCPReg(uint8_t reg, uint32_t v) {
+    if (fltCP(reg, v)) return;
+    GXPC_Put8(0x08);
+    GXPC_Put8(reg);
+    GXPC_Put32(v);
+}
