+// Draws op from its compiled shape; false when there is none that holds (natShape then takes the
+// stage-1 path, which compiles the shape again when it draws natively).
+static bool natPkgDraw(const SMS3DSJ3DShapeOp& op, uint64_t& t) {
+    NatPkg* k = natPkgGet(op.shape);
+    if (!k || k->vcdvat != op.vcdvat || k->pos != op.pos || k->nrm != op.nrm || k->col != op.col || k->matA != op.matA ||
+        k->matB != op.matB || k->ngroups != op.ngroups || !op.ngroups)
+        return false;
+    for (uint32_t gi = 0; gi < op.ngroups; gi++)
+        if (k->list[gi] != op.group[gi].list || k->size[gi] != op.group[gi].size) return false;
+    if (k->epoch != s_dlEpoch || k->agen != arenaGeneration() || k->beGen != s_beGen || k->beDef != s_defaultArrayBE ||
+        g_displayFrames - k->frame >= kDlRecheckFrames || g.bpMask != 0xFFFFFF || !arenaEnabled() || traceFile())
+        return false;
+    for (uint32_t i = 0; i < k->nranges; i++)
+        if (!unwrittenSince(k->ranges[i].p, k->ranges[i].n, k->clock)) return false;
+    njAdd(2, t);
+    GXPC_J3DStats[NJ_SHAPE]++;
+    GXPC_J3DPkgStats[0]++;
+    j3dBatchNative(true);
+    j3dStateOut();
+    for (uint32_t i = 0; i < k->ncp; i++) npCP(k->cp[i].first, k->cp[i].second);
+    natShapeCP(op);
+    njAdd(3, t);
+    for (uint32_t gi = 0; gi < op.ngroups; gi++) {
+        natGroupXF(k->xf, k->nxf, op, gi);
+        if (GXPC_J3DVerify) natVerifySig();
+        njAdd(5, t);
+        for (uint32_t r = k->run0[gi]; r < k->run0[gi + 1]; r++) {
+            const NatPkgRun& x = k->runs[r];
+            if (natBoxOffscreen(x.hasBox, x.box, x.nverts)) continue;
+            appendArena(x.cls, x.fmt, x.stride, x.arena, x.nverts, x.nidx, x.verts);
+        }
+        s_vertsLoaded += k->verts[gi];
+        njAdd(6, t);
+    }
+    return true;
+}
