+// Compiled shapes (docs/native-j3d.md, stage 1b; settings.txt native_j3d_packages). Once a shape's
+// op has drawn natively, what natShape worked out and checked for it is kept in one block: the op
+// fields it was worked out for, its vertex-format list's CP and XF writes, and every group's runs
+// as appendArena takes them. A later op with the same fields draws from the block after a few
+// checks, instead of finding the display-list cache's entries and comparing the vertex state with
+// them field by field (stage 1: ~32 us a shape on Delfino Plaza, mostly cache misses on entries,
+// their arrays and runs, and hash nodes, scattered over the heap). It draws what stage 1 would:
+// the block is used only while
+// - the vertex state its runs were decoded with follows from the op and its vertex-format list
+//   alone (blocks are made only then: natPkgDetermined), and the arrays' byte order is as it was;
+// - no entry it draws runs from has been recorded again, nor the cache cleared (s_dlEpoch), and
+//   its runs are still stored (the arena's generation);
+// - nothing was written, since it was checked, to the pages its lists and array data span (the
+//   write stamps), and it was checked in full (the stage-1 path, which hashes as the cache does)
+//   within kDlRecheckFrames frames.
+extern "C" {
+int GXPC_J3DPackages = 1;      // 0: every shape op takes the stage-1 path
+uint32_t GXPC_J3DPkgStats[4];  // shape ops drawn from compiled shapes, shapes compiled, not compilable, kept now
+}
+struct NatPkgRun {
+    const uint8_t* verts;  // the run's vertices (matrix-index runs: appendArena reads them once)
+    ArenaRef arena;
+    uint32_t fmt, stride, nverts, nidx;
+    float box[6];
+    PrimClass cls;
+    bool hasBox;
+};
+struct NatPkgRange {
+    const uint8_t* p;
+    uint32_t n;
+};
+struct NatPkg {
+    uint32_t shape, vcdvat, pos, nrm, col, matA, matB, ngroups;  // the op's fields it was made for
+    uint32_t list[8], size[8];
+    uint32_t epoch, agen, beGen, clock, frame;
+    bool beDef;
+    uint16_t ncp, nxf, nranges, run0[9];  // group g's runs: [run0[g], run0[g + 1])
+    uint32_t verts[8];                    // the vertices each group's entry loads ([perf])
+    std::pair<uint8_t, uint32_t>* cp;     // the vertex-format list's CP writes
+    J3DImage::Xf* xf;                     // and XF writes
+    NatPkgRun* runs;
+    NatPkgRange* ranges;  // the lists, and the array data their runs were decoded from
+};
+// By shape, open addressing (a few hundred shapes a scene).
+enum { kPkgSlots = 2048 };
+static uint32_t s_pkgKey[kPkgSlots];
+static NatPkg* s_pkg[kPkgSlots];
+static uint32_t s_pkgUsed;
+static inline uint32_t natPkgHash(uint32_t shape) { return (shape * 2654435761u) >> (32 - 11); }
+static NatPkg* natPkgGet(uint32_t shape) {
+    for (uint32_t i = natPkgHash(shape);; i = (i + 1) & (kPkgSlots - 1)) {
+        if (s_pkgKey[i] == shape) return s_pkg[i];
+        if (!s_pkgKey[i]) return nullptr;
+    }
+}
+static void natPkgPut(uint32_t shape, NatPkg* k) {
+    if (s_pkgUsed >= kPkgSlots * 3 / 4) {  // full: start over
+        for (uint32_t i = 0; i < kPkgSlots; i++) free(s_pkg[i]);
+        memset(s_pkgKey, 0, sizeof s_pkgKey);
+        memset(s_pkg, 0, sizeof s_pkg);
+        s_pkgUsed = 0;
+    }
+    uint32_t i = natPkgHash(shape);
+    while (s_pkgKey[i] && s_pkgKey[i] != shape) i = (i + 1) & (kPkgSlots - 1);
+    if (s_pkgKey[i]) {
+        free(s_pkg[i]);
+    } else {
+        s_pkgKey[i] = shape;
+        s_pkgUsed++;
+    }
+    s_pkg[i] = k;
+    GXPC_J3DPkgStats[3] = s_pkgUsed;
+}
+
+// True when the vertex state the entry was decoded with follows from the shape's vertex-format list
+// and its op alone (no register left by earlier commands decides how its lists decode).
+static bool natPkgDetermined(const NatShape& s, const DlEntry& e) {
+    uint32_t set[8] = {};
+    for (const auto& c : s.cp) set[c.first >> 5] |= 1u << (c.first & 31);
+    auto has = [&](uint32_t r) { return ((set[r >> 5] >> (r & 31)) & 1) != 0; };
+    if (!has(CP_VCD_LO) || !has(CP_VCD_HI)) return false;
+    for (uint32_t i = 0; i < 8; i++)
+        if ((e.vatMask >> i) & 1)
+            if (!has(CP_VAT_A + i) || !has(CP_VAT_B + i) || !has(CP_VAT_C + i)) return false;
+    for (const DlArray& a : e.arrays) {
+        if (a.slot >= 12 || !has(CP_ARRAY_STRIDE + a.slot)) return false;
+        if (a.slot > 2 && !has(CP_ARRAY_BASE + a.slot)) return false;  // (0-2: the op's)
+    }
+    return true;
+}
+
+// After natShape drew op natively from these entries: its compiled shape (clock: writeClock()
+// before its checks).
+static void natPkgMake(NatShape& s, const SMS3DSJ3DShapeOp& op, DlEntry* const* ent, uint32_t clock) {
+    if (!trustWriteStamps() || s.check.hashAlways || !arenaEnabled() || traceFile()) return;
+    // One whose block keeps failing (a page it spans written every frame, say) is left to the
+    // stage-1 path for a while rather than made again on every draw.
+    if (int32_t(g_displayFrames - s.pkgSkipUntil) < 0) return;
+    if (s.pkgMade && g_displayFrames - s.pkgMade < 60) {
+        if (++s.pkgRecent >= 4) {
+            s.pkgRecent = 0;
+            s.pkgSkipUntil = g_displayFrames + 1024;
+            GXPC_J3DPkgStats[2]++;
+            return;
+        }
+    } else {
+        s.pkgRecent = 0;
+    }
+    s.pkgMade = g_displayFrames;
+    const uint8_t* vcd = reinterpret_cast<const uint8_t*>(uintptr_t(op.vcdvat));
+    uint32_t nruns = 0, nranges = 1;
+    for (uint32_t gi = 0; gi < op.ngroups; gi++) {
+        if (!op.group[gi].list) continue;
+        const DlEntry* e = ent[gi];
+        if (!e || e->hashAlways || !natPkgDetermined(s, *e)) {
+            GXPC_J3DPkgStats[2]++;
+            return;
+        }
+        nruns += uint32_t(e->runs.size());
+        nranges += 1 + uint32_t(e->arrays.size());
+    }
+    if (nruns > 0xFFFF || nranges > 0xFFFF) return;
+    auto up8 = [](size_t n) { return (n + 7) & ~size_t(7); };
+    const size_t oCp = up8(sizeof(NatPkg)), oXf = oCp + up8(s.cp.size() * sizeof(s.cp[0])),
+                 oRuns = oXf + up8(s.xf.size() * sizeof(J3DImage::Xf)), oRanges = oRuns + up8(nruns * sizeof(NatPkgRun)),
+                 total = oRanges + nranges * sizeof(NatPkgRange);
+    uint8_t* mem = static_cast<uint8_t*>(malloc(total));
+    if (!mem) return;
+    NatPkg* k = new (mem) NatPkg();
+    k->shape = op.shape;
+    k->vcdvat = op.vcdvat;
+    k->pos = op.pos;
+    k->nrm = op.nrm;
+    k->col = op.col;
+    k->matA = op.matA;
+    k->matB = op.matB;
+    k->ngroups = op.ngroups;
+    k->epoch = s_dlEpoch;
+    k->agen = arenaGeneration();
+    k->beGen = s_beGen;
+    k->beDef = s_defaultArrayBE;
+    k->clock = clock;
+    k->frame = g_displayFrames;
+    k->ncp = uint16_t(s.cp.size());
+    k->nxf = uint16_t(s.xf.size());
+    k->cp = reinterpret_cast<std::pair<uint8_t, uint32_t>*>(mem + oCp);
+    k->xf = reinterpret_cast<J3DImage::Xf*>(mem + oXf);
+    k->runs = reinterpret_cast<NatPkgRun*>(mem + oRuns);
+    k->ranges = reinterpret_cast<NatPkgRange*>(mem + oRanges);
+    for (size_t i = 0; i < s.cp.size(); i++) new (&k->cp[i]) std::pair<uint8_t, uint32_t>(s.cp[i]);
+    for (size_t i = 0; i < s.xf.size(); i++) new (&k->xf[i]) J3DImage::Xf(s.xf[i]);
+    uint32_t nr = 0, ng = 0;
+    k->ranges[ng++] = NatPkgRange{vcd, 0xC0};
+    for (uint32_t gi = 0; gi < op.ngroups; gi++) {
+        k->list[gi] = op.group[gi].list;
+        k->size[gi] = op.group[gi].size;
+        k->run0[gi] = uint16_t(nr);
+        k->verts[gi] = 0;
+        DlEntry* e = op.group[gi].list ? ent[gi] : nullptr;
+        if (!e) continue;
+        e->pinned = true;
+        k->verts[gi] = e->verts;
+        k->ranges[ng++] = NatPkgRange{reinterpret_cast<const uint8_t*>(uintptr_t(op.group[gi].list)), op.group[gi].size};
+        for (const DlArray& a : e->arrays) k->ranges[ng++] = NatPkgRange{a.base + a.lo, a.hi - a.lo};
+        for (const DlRun& r : e->runs) {
+            NatPkgRun& x = *new (&k->runs[nr++]) NatPkgRun();
+            x.verts = r.verts.data();
+            x.arena = r.arena;
+            x.fmt = r.fmt;
+            x.stride = r.stride;
+            x.nverts = r.nverts;
+            x.nidx = uint32_t(r.idx.size());
+            memcpy(x.box, r.box, sizeof x.box);
+            x.cls = r.cls;
+            x.hasBox = r.hasBox;
+        }
+    }
+    k->run0[op.ngroups] = uint16_t(nr);
+    k->nranges = uint16_t(ng);
+    natPkgPut(op.shape, k);
+    GXPC_J3DPkgStats[1]++;
+}
