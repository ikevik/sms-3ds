+        ~Active() { s_dlActive--; }
+    } active;
     s_dlSeq++;
     GX_ZONE(GZ_DL_CHECK);
 #endif
@@ -2603,8 +2627,13 @@
 #else
     if (misses >= 3) e.skip = 4u << (misses - 3 < 8 ? misses - 3 : 8);
 #endif
+#if defined(__3DS__)
+    if (s_dlCacheBytes > GXPC_DlCacheMax) {  // keep the cache bounded: start over
