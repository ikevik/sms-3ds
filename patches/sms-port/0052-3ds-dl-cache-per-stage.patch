@@ -2012,6 +2012,14 @@
     s_dlIndex.clear();
     s_dlCacheBytes = 0;
 }
+#if defined(__3DS__)
+// 3DS port: the heap holds some 86 MB in all, so the cache starts over long before upstream's
+// 96 MB (GXPC_DlCacheMax), and the back end empties it when a new stage loads
+// (GXPC_DlCacheClearNow). Kept, the lists of the stages left behind added up: its 13 MB of runs
+// took some 19 MB of heap after Delfino Plaza and Bianco Hills, and the game ended at the next
+// movie's start with 83 of 86 MB in use (crash dump 41).
+static int s_dlActive;  // callDisplayListAt calls running (a cached list may be mid-replay)
+#endif
 static uint32_t s_dlLo[16], s_dlHi[16], s_dlElem[16];  // while recording: index range per array
 FILE* traceFile();
 
@@ -2070,6 +2078,18 @@
 #if defined(__3DS__)
 }  // namespace gx
 extern "C" size_t GXPC_DlCacheBytes(void) { return gx::s_dlCacheBytes; }
+#if defined(__3DS__)
+extern "C" {
+size_t GXPC_DlCacheMax = size_t(12) << 20;  // bytes of runs and state commands kept at most
+}
+// The front half's thread, between two commands: empties the cache unless a list is being called
+// (1: emptied).
+extern "C" int GXPC_DlCacheClearNow(void) {
+    if (gx::s_dlActive) return 0;
+    gx::dlClear();
+    return 1;
+}
+#endif
 extern "C" uint32_t GXPC_DlEntryCount(void) { return uint32_t(gx::s_dlEntries.size()); }
 namespace gx {
 #endif
