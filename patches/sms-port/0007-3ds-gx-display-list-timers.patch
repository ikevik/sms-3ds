+namespace {
+struct DlTimer {
+    int id;
+    uint64_t t0, o0;
+    explicit DlTimer(int i) : id(i), t0(svcGetSystemTick()), o0(GX3DS_OursTicks) {}
+    void to(int i) {
+        const uint64_t now = svcGetSystemTick(), o = GX3DS_OursTicks;
+        GXPC_DlTicks[id] += (now - t0) - (o - o0);
+        id = i;
+        t0 = now;
+        o0 = o;
+    }
+    ~DlTimer() { to(id); }
+};
+}
