+static void filterCheck(const uint8_t* p) {
+    static const char* const kKind[3] = {"BP", "CP", "XF"};
+    static uint32_t s_logged;
+    const int kind = p[1] < 3 ? p[1] : 0;
+    const uint32_t reg = uint32_t(p[2]) << 8 | p[3], n = p[4];
+    for (uint32_t k = 0; k < n; k++) {
+        const uint32_t v = be32(p + 5 + 4 * k);
+        uint32_t cur = v;
+        bool same = true;
+        if (kind == 0) {
+            cur = reg >= 0x100 ? g.kreg[reg & 7] : g.bp[reg & 0xFF];
+            same = (cur & 0xFFFFFF) == (v & 0xFFFFFF);
+        } else if (kind == 1) {
+            switch (reg & 0xF0) {
+            case CP_MATIDX_A: cur = g.cpMatA; break;
+            case CP_MATIDX_B: cur = g.cpMatB; break;
+            case CP_VCD_LO: cur = g.cpVcdLo; break;
+            case CP_VCD_HI: cur = g.cpVcdHi; break;
+            case CP_VAT_A: cur = g.cpVatA[reg & 7]; break;
+            case CP_VAT_B: cur = g.cpVatB[reg & 7]; break;
+            case CP_VAT_C: cur = g.cpVatC[reg & 7]; break;
+            case CP_ARRAY_BASE:
+                cur = uint32_t(uintptr_t(g.arrayBase[reg & 15]));
+                same = g.arrayBase[reg & 15] == physToPtr(v);
+                break;
+            case CP_ARRAY_STRIDE:
+                cur = g.arrayStride[reg & 15];
+                same = cur == (v & 0xFF);
+                break;
+            default: break;
+            }
+            if ((reg & 0xF0) != CP_ARRAY_BASE && (reg & 0xF0) != CP_ARRAY_STRIDE) same = cur == v;
+        } else {
+            const uint32_t a = reg + k;
+            if (a < XF_MEM_WORDS) cur = g.xfMem[a];
+            else if (a >= XF_REG_BASE && a < XF_REG_BASE + XF_REG_COUNT) cur = g.xfReg[a - XF_REG_BASE];
+            same = cur == v;
+        }
