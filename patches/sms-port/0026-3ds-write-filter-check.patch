+                   "holds %08x (%u of %u %s checks wrong so far)", kKind[kind], kind == 0 && reg >= 0x100 ? "konst " : "",
+                   unsigned(kind == 2 ? reg + k : reg & 0xFF), unsigned(v), unsigned(cur), unsigned(GXPC_FltWrong[kind]),
+                   unsigned(GXPC_FltChecks[kind]), kKind[kind]);
