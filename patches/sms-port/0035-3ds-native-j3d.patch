+inline bool bit(const uint32_t* m, uint32_t i) { return (m[i >> 5] >> (i & 31)) & 1; }
+inline void setBit(uint32_t* m, uint32_t i) { m[i >> 5] |= 1u << (i & 31); }
+void npBP(uint32_t i, uint32_t v, uint32_t mask) {
+    if (!bit(s_np.bpDirty, i)) {
+        setBit(s_np.bpDirty, i);
+        s_np.bpVal[i] = s_np.bpKnown[i] = 0;
+    }
