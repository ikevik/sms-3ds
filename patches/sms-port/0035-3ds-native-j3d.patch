+                continue;
+            }
+            if (tevReg && (data & 0x800000)) {
+                img->bp.push_back({uint16_t(256 + (reg & 7)), data, 0xFFFFFF});
+            } else {
+                img->bp.push_back({uint16_t(reg), data, mask});
+                if (texImage) {
+                    const int map = int(reg & 3) + ((reg & 0x20) ? 4 : 0);
+                    img->texImage[map] = static_cast<const uint8_t*>(physToPtr(data << 5));
+                    img->texMask |= uint8_t(1u << map);
+                }
+            }
+            mask = 0xFFFFFF;
+        } else if (op == 0x10) {
+            if (avail < 5) break;
+            const uint32_t hdr = be32(p + 1), cnt = (hdr >> 16) + 1;
+            if (avail < 5 + cnt * 4) break;
+            for (uint32_t i = 0; i < cnt; i++) {
+                const uint16_t a = uint16_t((hdr & 0xFFFF) + i);
+                if (a < XF_MEM_WORDS || (a >= XF_REG_BASE && a < XF_REG_BASE + XF_REG_COUNT))
+                    img->xf.push_back({a, be32(p + 5 + i * 4)});
+            }
+            p += 5 + cnt * 4;
+        } else {
+            ok = false;
+        }
+    }
+    if (!ok || p < end || mask != 0xFFFFFF) {
+        delete img;
+        return nullptr;
+    }
+    return img;
+}
+
+// A material list's op: its image, made once per list (again when the list's bytes change; an
+// old image is kept, as records in flight may name it).
+struct NatMat {
+    const uint8_t* list = nullptr;
+    uint32_t size = 0;
+    NatListCheck check;
+    J3DImage* img = nullptr;
+};
+static std::unordered_map<uintptr_t, NatMat> s_natMats;
+static std::vector<J3DImage*> s_natOldImages;
+
+// Whether applying the image would change a register (as the native ops and g leave them). An
+// image writing one register twice is taken as a change when the first value differs.
+static bool natImageChanges(const J3DImage& img) {
+    for (const J3DImage::Bp& b : img.bp) {
+        const uint32_t i = b.reg;
+        uint32_t cur = i < 256 ? g.bp[i] : g.kreg[i - 256];
+        if (bit(s_np.bpDirty, i)) cur = (cur & ~s_np.bpKnown[i]) | (s_np.bpVal[i] & s_np.bpKnown[i]);
+        if ((cur & b.mask) != (b.v & b.mask)) return true;
+    }
+    for (const J3DImage::Xf& x : img.xf)
+        if (effXF(x.addr) != x.v) return true;
+    for (int m = 0; m < 8; m++)
+        if ((img.texMask >> m) & 1) {
+            const uint8_t* cur = ((s_np.texDirty >> m) & 1) ? s_np.tex[m] : g.texImage[m];
+            if (cur != img.texImage[m]) return true;
+        }
+    return false;
+}
+
+static void natMaterial(const uint8_t* list, uint32_t size, bool check) {
+    uint64_t t = njNow();
+    NatMat& m = s_natMats[reinterpret_cast<uintptr_t>(list)];
+    if (m.list != list || m.size != size || !natListSame(list, size, m.check)) {
+        if (m.img) s_natOldImages.push_back(m.img);
+        m.list = list;
+        m.size = size;
+        m.img = natCompileMaterial(list, size);
+        natListTake(list, size, m.check);
+    }
+    njAdd(0, t);
+    if (check) {  // the call follows
+        s_npCheck = true;
+        s_npCheckKind = 0;
+        GXPC_J3DStats[NJ_CHECKS]++;
+        GXPC_J3DStats[m.img ? NJ_MAT : NJ_MAT_REPLAY]++;
+        if (m.img) npApply(*m.img);
+        return;
+    }
+    if (!m.img || g.bpMask != 0xFFFFFF) {
+        GXPC_J3DStats[NJ_MAT_REPLAY]++;
+        natHandOver();
+        callDisplayList(list, size);
+        return;
+    }
+    GXPC_J3DStats[NJ_MAT]++;
+    if (natImageChanges(*m.img)) {  // (the old path flushes only at a change: the batches merge)
+        flushBatch();
+        j3dEmitMaterial(m.img);
+        npApply(*m.img);
+    } else {
+        GXPC_J3DStats[NJ_MAT_SAME]++;
+    }
+    njAdd(1, t);
+}
+
+// A shape's vertex-format list: its CP and XF writes, or not expressible.
+struct NatShape {
+    uint32_t key = 0, vcdvat = 0;
+    NatListCheck check;
+    bool ok = false;
+    std::vector<std::pair<uint8_t, uint32_t>> cp;
+    std::vector<J3DImage::Xf> xf;
+};
+static std::unordered_map<uint32_t, NatShape> s_natShapes;
+
+static void natCompileVcd(NatShape& s, const uint8_t* p, uint32_t size) {
+    s.cp.clear();
+    s.xf.clear();
+    s.ok = true;
+    const uint8_t* end = p + size;
+    while (s.ok && p < end) {
+        const uint8_t op = p[0];
+        const uint32_t avail = uint32_t(end - p);
+        if (op == 0x00 || op == 0x48 || op == 0x44) {
+            p++;
+        } else if (op == 0x08 && avail >= 6) {
+            s.cp.push_back({p[1], be32(p + 2)});
+            p += 6;
+        } else if (op == 0x10 && avail >= 5) {
+            const uint32_t hdr = be32(p + 1), cnt = (hdr >> 16) + 1;
+            if (avail < 5 + cnt * 4) {
+                s.ok = false;
+                break;
+            }
+            for (uint32_t i = 0; i < cnt; i++) {
+                const uint16_t a = uint16_t((hdr & 0xFFFF) + i);
+                if (a < XF_MEM_WORDS || (a >= XF_REG_BASE && a < XF_REG_BASE + XF_REG_COUNT))
+                    s.xf.push_back({a, be32(p + 5 + i * 4)});
+            }
+            p += 5 + cnt * 4;
+        } else {
+            s.ok = false;
+        }
+    }
+}
+
+// The vertex state a shape's draw lists are decoded with: what the native ops and g leave, then
+// its vertex-format list's CP writes and its arrays.
+struct NatVtxState {
+    uint32_t vcdLo, vcdHi, vat[8][3];
+    const uint8_t* base[16];
+    uint32_t stride[16];
+    bool be[16];
+};
+// isBigEndianData for the native path, remembered per base (its range lookup walks a std::map:
+// ~2 us an array with the nodes out of cache, a dozen arrays a shape).
+static bool natBE(const uint8_t* b) {
+    struct Memo {
+        const uint8_t* b;
+        uint32_t gen;
+        bool def, be;
+    };
+    static Memo memo[64];
+    Memo& m = memo[(reinterpret_cast<uintptr_t>(b) >> 4) & 63];
+    if (m.b != b || m.gen != s_beGen || m.def != s_defaultArrayBE)
+        m = Memo{b, s_beGen, s_defaultArrayBE, s_defaultArrayBE || isBigEndianData(b)};
+    return m.be;
+}
+static void natCpInto(NatVtxState& v, uint8_t reg, uint32_t val) {
+    switch (reg & 0xF0) {  // as writeCP
+    case CP_VCD_LO: v.vcdLo = val; break;
+    case CP_VCD_HI: v.vcdHi = val; break;
+    case CP_VAT_A: v.vat[reg & 7][0] = val; break;
+    case CP_VAT_B: v.vat[reg & 7][1] = val; break;
+    case CP_VAT_C: v.vat[reg & 7][2] = val; break;
+    case CP_ARRAY_BASE: {
+        const uint8_t* b = static_cast<const uint8_t*>(physToPtr(val));
+        v.base[reg & 15] = b;
+        v.be[reg & 15] = natBE(b);
+        break;
+    }
+    case CP_ARRAY_STRIDE: v.stride[reg & 15] = val & 0xFF; break;
+    default: break;
+    }
+}
+static void natVtxState(const NatShape& s, const SMS3DSJ3DShapeOp& op, NatVtxState& v) {
+    v.vcdLo = g.cpVcdLo;
+    v.vcdHi = g.cpVcdHi;
+    for (int i = 0; i < 8; i++) {
+        v.vat[i][0] = g.cpVatA[i];
+        v.vat[i][1] = g.cpVatB[i];
+        v.vat[i][2] = g.cpVatC[i];
+    }
+    memcpy(v.base, g.arrayBase, sizeof v.base);
+    memcpy(v.stride, g.arrayStride, sizeof v.stride);
+    memcpy(v.be, g.arrayBigEndian, sizeof v.be);
+    for (uint32_t k = 0; k < 8; k++)
+        for (uint32_t m = s_np.cpDirty[k]; m; m &= m - 1) {
+            const uint32_t r = k * 32 + uint32_t(__builtin_ctz(m));
+            natCpInto(v, uint8_t(r), s_np.cp[r]);
+        }
+    for (const auto& c : s.cp) natCpInto(v, c.first, c.second);
+    natCpInto(v, CP_ARRAY_BASE + 0, op.pos);
+    natCpInto(v, CP_ARRAY_BASE + 1, op.nrm);
+    natCpInto(v, CP_ARRAY_BASE + 2, op.col);
+}
+
+// The draw list's entry can be drawn as recorded: decoded with this draw's vertex state, its data
+// unchanged, every run triangles stored in the arena now.
+static int natEntryOk(DlEntry& e, const uint8_t* list, uint32_t size, const NatVtxState& v,
+                      const SMS3DSJ3DShapeOp& op, uint64_t& t) {
+    if (!e.valid || e.stateOnly || e.skip || e.size != size) return NJ_R_ENTRY;
+    if (e.vcdLo != v.vcdLo || e.vcdHi != v.vcdHi) return NJ_R_STATE;
+    for (int i = 0; i < 8; i++)
+        if ((e.vatMask >> i) & 1)
+            if (e.vat[i][0] != v.vat[i][0] || e.vat[i][1] != v.vat[i][1] || e.vat[i][2] != v.vat[i][2]) return NJ_R_STATE;
+    if (e.usesMtx && (e.matA != op.matA || e.matB != op.matB)) return NJ_R_STATE;
+    for (const DlArray& a : e.arrays)
+        if (a.base != v.base[a.slot] || a.stride != v.stride[a.slot] || a.be != v.be[a.slot]) return NJ_R_STATE;
+    if (!arenaEnabled() || traceFile()) return NJ_R_ARENA;
+    for (const DlRun& r : e.runs)
+        if (r.cls != PRIM_TRIS || r.idx.empty() || r.arena.gen != arenaGeneration()) return NJ_R_ARENA;
+    njAdd(3, t);
+    const uint64_t h0 = GXPC_DlHashed;
+    const bool same = dlDataSame(e, list, size, false, 0);
+    GXPC_J3DHashed += GXPC_DlHashed - h0;
+    njAdd(4, t);
+    return same ? -1 : NJ_R_DATA;
+}
+
+// An indexed matrix load's words, read as loadIndexedXF reads them.
+static void natMtxWords(uint32_t baseHost, uint32_t stride, uint32_t idx, uint32_t n, uint32_t* out) {
+    const uint8_t* base = static_cast<const uint8_t*>(physToPtr(ptrToPhys(reinterpret_cast<const void*>(uintptr_t(baseHost)))));
+    const bool be = natBE(base);
+    const uint8_t* src = base + size_t(idx) * stride;
+    for (uint32_t k = 0; k < n; k++)
+        out[k] = be ? be32(src + k * 4)
+                    : (uint32_t(src[k * 4]) | uint32_t(src[k * 4 + 1]) << 8 | uint32_t(src[k * 4 + 2]) << 16 |
+                       uint32_t(src[k * 4 + 3]) << 24);
+}
+
+// The shape's calls, replayed (the old path).
+static void natReplayShape(const SMS3DSJ3DShapeOp& op) {
+    callDisplayList(reinterpret_cast<const uint8_t*>(uintptr_t(op.vcdvat)), 0xC0);
+    writeCP(CP_ARRAY_BASE + 0, op.pos);
+    writeCP(CP_ARRAY_BASE + 1, op.nrm);
+    writeCP(CP_ARRAY_BASE + 2, op.col);
+    writeCP(CP_ARRAY_BASE + 12, ptrToPhys(reinterpret_cast<const void*>(uintptr_t(op.drawMtx))));
+    writeCP(CP_ARRAY_STRIDE + 12, 0x30);
+    writeCP(CP_ARRAY_BASE + 13, ptrToPhys(reinterpret_cast<const void*>(uintptr_t(op.nrmMtx))));
+    writeCP(CP_ARRAY_STRIDE + 13, 0x24);
+    writeCP(CP_MATIDX_A, op.matA);
+    writeCP(CP_MATIDX_B, op.matB);
+    const uint32_t mi[2] = {op.matA, op.matB};
+    writeXF(uint16_t(XF_REG_BASE + XFR_MATIDX_A), 2, mi);
+    for (uint32_t gi = 0; gi < op.ngroups; gi++) {
+        const SMS3DSJ3DShapeOp::Group& gr = op.group[gi];
+        for (uint32_t k = 0; k < gr.nslots; k++) {
+            if (gr.idx[k] == 0xFFFF) continue;
+            loadIndexedXF(0x20, gr.idx[k], (11u << 12) | (k * 12));
+            loadIndexedXF(0x28, gr.idx[k], (8u << 12) | (0x400 + k * 9));
+        }
+        if (gr.list) callDisplayList(reinterpret_cast<const uint8_t*>(uintptr_t(gr.list)), gr.size);
+    }
+}
+
+// The XF words a shape group sets: its matrix indices and its vertex-format list's (first group),
+// its matrices. Sent to the render thread (the open batch drawn first) when one differs.
+static void natGroupXF(const NatShape& s, const SMS3DSJ3DShapeOp& op, uint32_t gi) {
+    static uint32_t pairs[2 * (64 + 2 + 10 * 21)];
+    uint32_t n = 0;
+    auto add = [&](uint32_t a, uint32_t v) {
+        pairs[2 * n] = a;
+        pairs[2 * n + 1] = v;
+        n++;
+    };
+    if (gi == 0) {
+        for (const J3DImage::Xf& x : s.xf)
+            if (n < 64) add(x.addr, x.v);
+        add(XF_REG_BASE + XFR_MATIDX_A, op.matA);
+        add(XF_REG_BASE + XFR_MATIDX_B, op.matB);
+    }
+    const SMS3DSJ3DShapeOp::Group& gr = op.group[gi];
+    for (uint32_t k = 0; k < gr.nslots; k++) {
+        if (gr.idx[k] == 0xFFFF) continue;
+        uint32_t w[12];
+        natMtxWords(op.drawMtx, 0x30, gr.idx[k], 12, w);
+        for (uint32_t i = 0; i < 12; i++) add(k * 12 + i, w[i]);
+        natMtxWords(op.nrmMtx, 0x24, gr.idx[k], 9, w);
+        for (uint32_t i = 0; i < 9; i++) add(0x400 + k * 9 + i, w[i]);
+    }
+    bool differs = false;
+    for (uint32_t i = 0; i < n && !differs; i++) differs = effXF(pairs[2 * i]) != pairs[2 * i + 1];
+    if (!differs) return;
+    flushBatch();
+    j3dEmitXF(pairs, n);
+    GXPC_J3DStats[NJ_XF_SENT]++;
+    for (uint32_t i = 0; i < n; i++) npXF(pairs[2 * i], pairs[2 * i + 1]);
+}
+
+// The konst colours and texture images as the native ops and g leave them: a native draw's
+// record carries them, as every draw record carries g's (the render side gets them only so; an
+// emulated write between a native material and its shapes, a shape packet's callback setting a
+// konst colour or loading a texture, reaches it this way).
+void j3dEffKregTex(uint32_t* kreg, const uint8_t** tex) {
+    for (uint32_t k = 0; k < 8; k++) kreg[k] = bit(s_np.bpDirty, 256 + k) ? s_np.bpVal[256 + k] : g.kreg[k];
+    for (int m = 0; m < 8; m++) tex[m] = ((s_np.texDirty >> m) & 1) ? s_np.tex[m] : g.texImage[m];
+}
+
+// Verify mode: the registers as the native ops and g leave them, for the render thread to compare
+// with its own (BP, konst colours, texture images, XF registers in full; XF memory as 64-word
+// block hashes).
+static void natVerifySig() {
+    static uint32_t w[256 + 8 + 8 + XF_REG_COUNT + (XF_MEM_WORDS + 63) / 64];
+    uint32_t n = 0;
+    for (uint32_t i = 0; i < 264; i++) {
+        uint32_t v = i < 256 ? g.bp[i] : g.kreg[i - 256];
+        if (bit(s_np.bpDirty, i)) v = (v & ~s_np.bpKnown[i]) | (s_np.bpVal[i] & s_np.bpKnown[i]);
+        w[n++] = v;
+    }
+    for (int m = 0; m < 8; m++)
+        w[n++] = uint32_t(uintptr_t(((s_np.texDirty >> m) & 1) ? s_np.tex[m] : g.texImage[m]));
+    for (uint32_t r = 0; r < XF_REG_COUNT; r++) w[n++] = effXF(XF_REG_BASE + r);
+    for (uint32_t b = 0; b < XF_MEM_WORDS; b += 64) {
+        uint32_t h = 2166136261u;
+        for (uint32_t a = b; a < b + 64 && a < XF_MEM_WORDS; a++) h = (h ^ effXF(a)) * 16777619u;
+        w[n++] = h;
+    }
+    j3dEmitSig(w, n);
+    GXPC_J3DStats[NJ_VERIFIED]++;
+}
+
+// dlRunOffscreen for a native draw: the position matrix as the native ops left it.
+static bool natRunOffscreen(const DlRun& r) {
+    if (!r.hasBox || GXPC_CullOff || effXF(XF_REG_BASE + 0x05) != 0) return false;
+    const uint32_t pm = effXF(XF_REG_BASE + XFR_MATIDX_A) & 63;
+    if (pm * 4 + 12 > XF_MEM_WORDS) return false;
+    float m[12], P[6];
+    for (int i = 0; i < 12; i++) {
+        const uint32_t w = effXF(pm * 4 + i);
+        memcpy(&m[i], &w, 4);
+    }
+    for (int i = 0; i < 6; i++) {
+        const uint32_t w = effXF(XF_REG_BASE + XFR_PROJ + i);
+        memcpy(&P[i], &w, 4);
+    }
+    const bool ortho = effXF(XF_REG_BASE + XFR_PROJ + 6) & 1;
+    int l = 0, rt = 0, b = 0, t = 0, behind = 0;
+    for (int c = 0; c < 8; c++) {
+        const float x = r.box[(c & 1) ? 3 : 0], y = r.box[(c & 2) ? 4 : 1], z = r.box[(c & 4) ? 5 : 2];
+        const float vx = m[0] * x + m[1] * y + m[2] * z + m[3];
+        const float vy = m[4] * x + m[5] * y + m[6] * z + m[7];
+        const float vz = m[8] * x + m[9] * y + m[10] * z + m[11];
+        float cx, cy, cw;
+        if (!ortho) {
+            cx = P[0] * vx + P[1] * vz;
+            cy = P[2] * vy + P[3] * vz;
+            cw = -vz;
+        } else {
+            cx = P[0] * vx + P[1];
+            cy = P[2] * vy + P[3];
+            cw = 1.0f;
+        }
+        const float mw = 1.25f * cw;
+        l += cx < -mw;
+        rt += cx > mw;
+        b += cy < -mw;
+        t += cy > mw;
+        behind += cw <= 0.0f;
+    }
+    if (l < 8 && rt < 8 && b < 8 && t < 8 && behind < 8) return false;
+    GXPC_CullRuns++;
+    GXPC_CullVerts += r.nverts;
+    GXPC_J3DStats[NJ_CULLED]++;
+    return true;
+}
+
+static void natShape(const SMS3DSJ3DShapeOp& op, bool check) {
+    uint64_t t = njNow();
+    NatShape& s = s_natShapes[op.shape];
+    const uint8_t* vcd = reinterpret_cast<const uint8_t*>(uintptr_t(op.vcdvat));
+    if (s.key != op.shape || s.vcdvat != op.vcdvat || !natListSame(vcd, 0xC0, s.check)) {
+        s.key = op.shape;
+        s.vcdvat = op.vcdvat;
+        natCompileVcd(s, vcd, 0xC0);
+        natListTake(vcd, 0xC0, s.check);
+    }
+    njAdd(2, t);
+    int why = s.ok && g.bpMask == 0xFFFFFF && op.ngroups ? -1 : NJ_R_VCD;
+    DlEntry* ent[8] = {};
+    if (why < 0) {
+        NatVtxState v;
+        natVtxState(s, op, v);
+        for (uint32_t gi = 0; gi < op.ngroups && why < 0; gi++) {
+            const SMS3DSJ3DShapeOp::Group& gr = op.group[gi];
+            if (!gr.list) continue;
+            ent[gi] = dlFind(reinterpret_cast<const void*>(uintptr_t(gr.list)));
+            why = ent[gi] ? natEntryOk(*ent[gi], reinterpret_cast<const uint8_t*>(uintptr_t(gr.list)), gr.size, v, op, t)
+                          : NJ_R_ENTRY;
+        }
+    }
+    njAdd(3, t);
+    if (check) {  // the calls follow: what they should leave
+        s_npCheck = true;
+        s_npCheckKind = 1;
+        GXPC_J3DStats[NJ_CHECKS]++;
+        GXPC_J3DStats[why < 0 ? NJ_SHAPE : NJ_SHAPE_REPLAY]++;
+        if (why >= 0) GXPC_J3DStats[why]++;
+        for (const auto& c : s.cp) npCP(c.first, c.second);
+        for (const J3DImage::Xf& x : s.xf) npXF(x.addr, x.v);
+        npCP(CP_ARRAY_BASE + 0, op.pos);
+        npCP(CP_ARRAY_BASE + 1, op.nrm);
+        npCP(CP_ARRAY_BASE + 2, op.col);
+        npCP(CP_ARRAY_BASE + 12, ptrToPhys(reinterpret_cast<const void*>(uintptr_t(op.drawMtx))));
+        npCP(CP_ARRAY_STRIDE + 12, 0x30);
+        npCP(CP_ARRAY_BASE + 13, ptrToPhys(reinterpret_cast<const void*>(uintptr_t(op.nrmMtx))));
+        npCP(CP_ARRAY_STRIDE + 13, 0x24);
+        npCP(CP_MATIDX_A, op.matA);
+        npCP(CP_MATIDX_B, op.matB);
+        npXF(XF_REG_BASE + XFR_MATIDX_A, op.matA);
+        npXF(XF_REG_BASE + XFR_MATIDX_B, op.matB);
+        for (uint32_t gi = 0; gi < op.ngroups; gi++)
+            for (uint32_t k = 0; k < op.group[gi].nslots; k++) {
+                if (op.group[gi].idx[k] == 0xFFFF) continue;
+                uint32_t w[12];
+                natMtxWords(op.drawMtx, 0x30, op.group[gi].idx[k], 12, w);
+                for (uint32_t i = 0; i < 12; i++) npXF(k * 12 + i, w[i]);
+                natMtxWords(op.nrmMtx, 0x24, op.group[gi].idx[k], 9, w);
+                for (uint32_t i = 0; i < 9; i++) npXF(0x400 + k * 9 + i, w[i]);
+            }
+        return;
+    }
+    if (why >= 0) {
+        GXPC_J3DStats[NJ_SHAPE_REPLAY]++;
+        GXPC_J3DStats[why]++;
+        natHandOver();
+        natReplayShape(op);
+        return;
+    }
+    GXPC_J3DStats[NJ_SHAPE]++;
+    j3dBatchNative(true);
+    j3dStateOut();
+    for (const auto& c : s.cp) npCP(c.first, c.second);
+    npCP(CP_ARRAY_BASE + 0, op.pos);
+    npCP(CP_ARRAY_BASE + 1, op.nrm);
+    npCP(CP_ARRAY_BASE + 2, op.col);
+    npCP(CP_ARRAY_BASE + 12, ptrToPhys(reinterpret_cast<const void*>(uintptr_t(op.drawMtx))));
+    npCP(CP_ARRAY_STRIDE + 12, 0x30);
+    npCP(CP_ARRAY_BASE + 13, ptrToPhys(reinterpret_cast<const void*>(uintptr_t(op.nrmMtx))));
+    npCP(CP_ARRAY_STRIDE + 13, 0x24);
+    npCP(CP_MATIDX_A, op.matA);
+    npCP(CP_MATIDX_B, op.matB);
+    njAdd(3, t);
+    for (uint32_t gi = 0; gi < op.ngroups; gi++) {
+        natGroupXF(s, op, gi);
+        if (GXPC_J3DVerify) natVerifySig();
+        njAdd(5, t);
+        DlEntry* e = ent[gi];
+        if (!e) continue;
+        for (DlRun& r : e->runs) {
+            if (natRunOffscreen(r)) continue;
+            appendArena(r.cls, r.fmt, r.stride, r.arena, r.nverts, uint32_t(r.idx.size()), r.verts.data());
+        }
+        s_vertsLoaded += e->verts;
+        e->misses = 0;
+        njAdd(6, t);
+    }
+}
+
+// kStreamOpJ3DEnd (check mode): what the calls left against what the op said they would.
+static void natCheckEnd() {
+    if (!s_npCheck) return;
+    static uint32_t s_logged;
+    auto bad = [](const char* what, uint32_t reg, uint32_t want, uint32_t got) {
+        GXPC_J3DStats[NJ_CHECK_BAD]++;
+        if (s_logged++ < 40)
+            logmsg("[j3d] check: %s op left %s %03lx = %08lx, the calls %08lx", s_npCheckKind ? "shape" : "material",
+                   what, (unsigned long)reg, (unsigned long)want, (unsigned long)got);
+    };
+    for (uint32_t k = 0; k < 9; k++)
+        for (uint32_t m = s_np.bpDirty[k]; m; m &= m - 1) {
+            const uint32_t i = k * 32 + uint32_t(__builtin_ctz(m));
+            const uint32_t known = s_np.bpKnown[i], val = s_np.bpVal[i];
+            const uint32_t got = i < 256 ? g.bp[i] : g.kreg[i - 256];
+            if ((got & known) != (val & known)) bad(i < 256 ? "BP" : "konst", i, val, got);
+        }
+    for (int m = 0; m < 8; m++)
+        if (((s_np.texDirty >> m) & 1) && g.texImage[m] != s_np.tex[m])
+            bad("texture image", uint32_t(m), uint32_t(uintptr_t(s_np.tex[m])), uint32_t(uintptr_t(g.texImage[m])));
+    for (uint32_t k = 0; k < (XF_MEM_WORDS + 31) / 32; k++)
+        for (uint32_t m = s_np.xfMemDirty[k]; m; m &= m - 1) {
+            const uint32_t a = k * 32 + uint32_t(__builtin_ctz(m));
+            if (g.xfMem[a] != s_np.xfMem[a]) bad("XF memory", a, s_np.xfMem[a], g.xfMem[a]);
+        }
+    for (uint32_t k = 0; k < (XF_REG_COUNT + 31) / 32; k++)
+        for (uint32_t m = s_np.xfRegDirty[k]; m; m &= m - 1) {
+            const uint32_t r = k * 32 + uint32_t(__builtin_ctz(m));
+            if (g.xfReg[r] != s_np.xfReg[r]) bad("XF register", XF_REG_BASE + r, s_np.xfReg[r], g.xfReg[r]);
+        }
+    for (uint32_t k = 0; k < 8; k++)
+        for (uint32_t m = s_np.cpDirty[k]; m; m &= m - 1) {
+            const uint32_t r = k * 32 + uint32_t(__builtin_ctz(m)), v = s_np.cp[r];
+            uint32_t got = v;
+            switch (r & 0xF0) {
+            case CP_MATIDX_A: got = g.cpMatA; break;
+            case CP_MATIDX_B: got = g.cpMatB; break;
+            case CP_VCD_LO: got = g.cpVcdLo; break;
+            case CP_VCD_HI: got = g.cpVcdHi; break;
+            case CP_VAT_A: got = g.cpVatA[r & 7]; break;
+            case CP_VAT_B: got = g.cpVatB[r & 7]; break;
+            case CP_VAT_C: got = g.cpVatC[r & 7]; break;
+            case CP_ARRAY_BASE: got = g.arrayBase[r & 15] == physToPtr(v) ? v : ~v; break;
+            case CP_ARRAY_STRIDE: got = g.arrayStride[r & 15] == (v & 0xFF) ? v : ~v; break;
+            default: break;
+            }
+            if (got != v) bad("CP", r, v, got);
+        }
+    npClear();
+    s_npCheck = false;
+}
+
+// The stream's native J3D ops (streamOpRun).
+static void natOp(const uint8_t* p) {
+    if (p[0] == kStreamOpJ3DMat) {
+        natMaterial(reinterpret_cast<const uint8_t*>(uintptr_t(be32(p + 1))), be32(p + 5), p[9] != 0);
+    } else if (p[0] == kStreamOpJ3DShape) {
+        SMS3DSJ3DShapeOp op;
+        memcpy(&op, p + 4, kJ3DShapeHead - 4);
+        op.ngroups = p[2] <= 8 ? p[2] : 8;
+        memcpy(op.group, p + kJ3DShapeHead, op.ngroups * sizeof(op.group[0]));
+        natShape(op, p[1] != 0);
+    } else {
+        natCheckEnd();
+    }
+}
