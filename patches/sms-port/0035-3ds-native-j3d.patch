+        setBit(s_np.xfMemDirty, addr);
+    } else if (addr >= XF_REG_BASE && addr < XF_REG_BASE + XF_REG_COUNT) {
+        s_np.xfReg[addr - XF_REG_BASE] = v;
+        setBit(s_np.xfRegDirty, addr - XF_REG_BASE);
+    } else {
+        return;
+    }
+    s_np.any = true;
