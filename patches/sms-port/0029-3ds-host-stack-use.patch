+// Each live host thread's function, and the most of its stack it has used: what is no longer
+// the paint, from the bottom up. "!" marks one whose painted bottom was overwritten (2 KiB
+// from the end, or past it). Returns the length written.
+extern "C" int port_os_stack_report(char* out, int n)
+{
+	int at = 0;
+	out[0] = 0;
+	for (int i = 0; i < kStackRecs && at < n - 48; i++) {
+		if (__atomic_load_n(&g_stacks[i].live, __ATOMIC_ACQUIRE) != 1)
+			continue;
+		const StackRec r = g_stacks[i];
+		const u32* p     = r.lo;
+		while (p < r.top - 512 / 4 && *p == kStackPaint)
+			p++;
+		const unsigned used = (unsigned)((r.top - p) * 4) >> 10;
+		at += snprintf(out + at, n - at, "%s fn %08lx %u/%u%s", at ? " |" : "", (unsigned long)(uintptr_t)r.func,
+		               used, (unsigned)(r.size >> 10), p == r.lo ? "!" : "");
+	}
+	return at;
+}
 #endif
