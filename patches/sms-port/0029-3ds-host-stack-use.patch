 int g_live_hosts;
-#define LIVE_HOST_END() __atomic_sub_fetch(&g_live_hosts, 1, __ATOMIC_RELAXED)
+// 3DS port: each host thread paints its stack as it starts, and port_os_stack_report (the
+// renderer's [perf] lines) says how much of it each has used since. An overflow writes over
+// whatever the heap holds below the stack, far from the thread that caused it. Kept in a
+// fixed table, not the scheduler's map: the report runs on a renderer thread.
+struct StackRec {
+	u32* lo; // the painted words, lo up to the top less 512 bytes
+	u32* top;
+	u32 size, gc;
+	void* func;
+	int live; // 0 free, 1 in use, 2 being filled
+};
+const int kStackRecs   = 48;
+const u32 kStackPaint  = 0x57AC57ACu;
+StackRec g_stacks[kStackRecs];
+__thread int t_stack_slot = -1;
+// On the new host thread, first thing: the stack runs from about here down host_stack bytes;
+// the lowest 2 KiB are left unpainted (libctru's start code is above this frame, not below).
+void stack_paint(Host* h)
+{
+	volatile u32 here = 0;
+	u32* top = (u32*)((uintptr_t)&here & ~(uintptr_t)3);
+	u32* lo  = top - h->host_stack / 4 + 2048 / 4;
+	u32* hi  = top - 512 / 4;
+	for (volatile u32* p = lo; p < hi; p++)
+		*p = kStackPaint;
+	for (int i = 0; i < kStackRecs; i++) {
+		int expect = 0;
+		if (!__atomic_compare_exchange_n(&g_stacks[i].live, &expect, 2, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+			continue;
+		g_stacks[i].lo   = lo;
+		g_stacks[i].top  = top;
+		g_stacks[i].size = h->host_stack;
+		g_stacks[i].gc   = h->gc_stack;
+		g_stacks[i].func = (void*)h->func;
+		__atomic_store_n(&g_stacks[i].live, 1, __ATOMIC_RELEASE);
+		t_stack_slot = i;
+		return;
+	}
+}
+void stack_end()
+{
+	if (t_stack_slot >= 0)
+		__atomic_store_n(&g_stacks[t_stack_slot].live, 0, __ATOMIC_RELEASE);
+	t_stack_slot = -1;
+}
+#define LIVE_HOST_END() (stack_end(), __atomic_sub_fetch(&g_live_hosts, 1, __ATOMIC_RELAXED))
