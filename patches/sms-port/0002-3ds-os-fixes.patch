--- a/platform/os/crash_info.cpp
+++ b/platform/os/crash_info.cpp
@@ -94,6 +94,10 @@
 	vm_size_t copied = 0;
 	return vm_read_overwrite(mach_task_self(), (vm_address_t)from, size, (vm_address_t)to, &copied) == KERN_SUCCESS &&
 	       copied == size;
+#elif defined(__3DS__)
+	// Horizon has no process_vm_readv; refuse rather than risk a data abort while reporting one.
+	(void)to; (void)from; (void)size;
+	return false;
