+// 3DS port (decomp patch 3ds-0026, platform/3ds/prof_3ds.cpp): a caller whose scissor leaves no
+// pixel outside a band of x gives the band in the print's own x (SMS3DS_PrintClip set,
+// SMS3DS_PrintClipX0/X1, a margin included; for a JUTResFont); parse then leaves out each glyph
+// whose quad, as drawChar_scale works it out, lies wholly outside the band, as it would draw no
+// pixel. The last glyph left out is drawn after all when no glyph is drawn after it, so the font's
+// texture page and the vertex format end as the original leaves them; a glyph drawn loads its own
+// page, as there. SMS3DS_PrintGlyphs counts the glyphs drawn and those left out under a band.
+extern "C" int SMS3DS_PrintClip;
+extern "C" float SMS3DS_PrintClipX0, SMS3DS_PrintClipX1;
+extern "C" unsigned long SMS3DS_PrintGlyphs[2];
+namespace {
+struct PrintLeftOut {
+	bool on, flag;
+	f32 x, y;
+	int sizeX, sizeY, chr;
+	PrintLeftOut()
+	    : on(false), flag(false), x(0.0f), y(0.0f), sizeX(0), sizeY(0), chr(0)
+	{
+	}
+	// true: the glyph at (at, atY) is left out (and kept as the last left out)
+	bool leaveOut(JUTFont* font, f32 at, f32 atY, int sx, int sy, int c, bool f)
+	{
+		if (!SMS3DS_PrintClip)
+			return false;
+		f32 x1 = at;  // drawChar_scale's x1 and x2
+		if (!font->isFixed() && f) {
+			JUTFont::TWidth w;
+			font->getWidthEntry(c, &w);
+			x1 = at - w.field_0x0 * ((f32)sx / font->getWidth());
+		}
+		const f32 x2 = x1 + sx;
+		if (x2 < SMS3DS_PrintClipX0 || x1 > SMS3DS_PrintClipX1) {
+			on = true, flag = f, x = at, y = atY, sizeX = sx, sizeY = sy, chr = c;
+			SMS3DS_PrintGlyphs[1]++;
+			return true;
+		}
+		on = false;
+		SMS3DS_PrintGlyphs[0]++;
+		return false;
+	}
+};
+}  // namespace
+#endif
