+#if defined(__3DS__)
+// 3DS port (decomp patch 3ds-0026, platform/3ds/prof_3ds.cpp): the news ticker's two text boxes
+// (the text and its shadow) hold the whole message and draw every glyph of it each frame, while
+// the scissor shows only the ticker's window. With SMS3DS_TelopClip set, each box's print is given
+// the window in the text's own x, widened by 16 pixels each side (J2DPrint.cpp, the same patch),
+// and leaves out the glyphs wholly outside it. The window comes from the scissor and the GX
+// projection and viewport in force, and only for an orthographic projection and an unrotated box
+// (its matrix then a translation by x); otherwise every glyph is drawn.
+extern "C" int SMS3DS_TelopClip;
+extern "C" int SMS3DS_PrintClip;
+extern "C" float SMS3DS_PrintClipX0, SMS3DS_PrintClipX1;
+static void telopClip(const J2DTextBox* box, int x, const JDrama::TRect& scissor)
+{
+	SMS3DS_PrintClip = 0;
+	if (!SMS3DS_TelopClip || box->getRotation() != 0.0f)
+		return;
+	f32 p[7], vp[6];
+	GXGetProjectionv(p);
+	GXGetViewportv(vp);
+	if (p[0] != (f32)GX_ORTHOGRAPHIC || !(p[1] > 0.0f) || !(vp[2] > 0.0f))
+		return;
+	// an x of u on the 2D plane lands on EFB x vp[0] + vp[2] * (p[1] * u + p[2] + 1) / 2
+	const f32 margin = 16.0f;
+	SMS3DS_PrintClipX0
+	    = ((scissor.x1 - margin - vp[0]) * 2.0f / vp[2] - 1.0f - p[2]) / p[1] - x;
+	SMS3DS_PrintClipX1
+	    = ((scissor.x2 + margin - vp[0]) * 2.0f / vp[2] - 1.0f - p[2]) / p[1] - x;
+	SMS3DS_PrintClip = 1;
 }
+#endif
 
