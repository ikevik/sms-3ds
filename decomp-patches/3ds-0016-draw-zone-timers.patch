--- /dev/null
+++ b/include/sms3ds_zone.h
@@ -0,0 +1,23 @@
+// 3DS port (decomp patch 3ds-0016): profile-run timers around a few drawing routines, reported by
+// platform/3ds/prof_3ds.cpp (calls, time and GX stream bytes per frame, nested ones included).
+// Outside a profile run each costs one branch.
+#ifndef SMS3DS_ZONE_H
+#define SMS3DS_ZONE_H
+#if defined(__3DS__)
+extern "C" int SMS3DS_ProfOn;
+extern "C" int SMS3DS_ZoneBegin(int zone);
+extern "C" void SMS3DS_ZoneEnd(int zone, int token);
+struct SMS3DSZone {
+	int zone, token;
+	explicit SMS3DSZone(int z) : zone(z), token(SMS3DS_ProfOn ? SMS3DS_ZoneBegin(z) : -1) {}
+	~SMS3DSZone()
+	{
+		if (token >= 0)
+			SMS3DS_ZoneEnd(zone, token);
+	}
+};
+#define SMS3DS_ZONE(n) SMS3DSZone sms3ds_zone_(n)
+#else
+#define SMS3DS_ZONE(n)
+#endif
+#endif
