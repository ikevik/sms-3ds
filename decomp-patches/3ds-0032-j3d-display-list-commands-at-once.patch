+}
+
+inline void J3DGDWriteXFCmd(u16 cmd, u32 param)
+{
+	u8* p = J3DGDTake(9);
+	p[0] = GX_CMD_LOAD_XF_REG;
+	J3DGDPut16(p + 1, 0);
+	J3DGDPut16(p + 3, cmd);
+	J3DGDPut32(p + 5, param);
+}
+
+inline void J3DGDWriteXFCmdHdr(u16 cmd, u8 len)
