 inline void J3DGDWrite_u8(u8 param) { __GDWrite(param); }
 
+#if defined(__3DS__)
+// 3DS port (decomp patch 3ds-0032): the same bytes, each command's written at once. __GDWrite stores
+// a byte through __GDCurrentDL->ptr, and a byte store may alias both, so every byte reloaded them
+// and stored the pointer back: ~6 instructions a byte, in the material display lists J3D rebuilds
+// every frame. Here the pointer moves once a command and its words go out byte-swapped (the list
+// is big-endian), stored unaligned as the ARM11 allows.
+#include <string.h>
+static inline u8* J3DGDTake(u32 n)
+{
+	GDLObj* dl = __GDCurrentDL;
+	u8* p = dl->ptr;
+	dl->ptr = p + n;
+	return p;
+}
+static inline void J3DGDPut32(u8* p, u32 v)
+{
+	v = __builtin_bswap32(v);
+	memcpy(p, &v, 4);
+}
+static inline void J3DGDPut16(u8* p, u16 v)
+{
+	p[0] = (u8)(v >> 8);
+	p[1] = (u8)v;
+}
+
+inline void J3DGDWrite_u16(u16 param) { J3DGDPut16(J3DGDTake(2), param); }
+
+static inline void J3DGDWrite_u32(u32 param) { J3DGDPut32(J3DGDTake(4), param); }
+#else
 inline void J3DGDWrite_u16(u16 param)
 {
 	__GDWrite((u8)(param >> 8));
@@ -20,6 +49,7 @@
 	__GDWrite((u8)((param >> 8) & 0xff));
 	__GDWrite((u8)((param >> 0) & 0xff));
 }
+#endif
 
