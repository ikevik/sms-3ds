--- a/src/System/EventWatcher.cpp
+++ b/src/System/EventWatcher.cpp
@@ -92,6 +92,59 @@
 	interp->push(name);
 }
 
+#if defined(__3DS__)
+// 3DS port (decomp patch 3ds-0029): getNameRefPtr's lookups by name answered from a cache. A full
+// search's answer (the first match in the scene's name tree, depth first) changes only when the
+// tree does, and every change to the tree bumps SMS3DS_NameTreeGen (sms3ds_names.h), so an answer
+// kept with the root and the generation it was found under is the full search's answer while both
+// hold. SMS3DS_NameCache: 0 off (every lookup a full search, as the original), 1 on (the default;
+// settings.txt name_cache), 2 each answer from the cache checked against a full search.
+#include "sms3ds_names.h"
+extern "C" int SMS3DS_NameCache;
+// Lookups by name, answered from the cache, checked, differing, answers kept.
+extern "C" unsigned SMS3DS_NameCacheStats[5];
+namespace {
+struct TNameCacheEntry {
+	JDrama::TNameRef* root;
+	JDrama::TNameRef* result;
+	unsigned gen;
+	u16 key;
+	char name[54];  // the name looked up (longer ones are not kept)
+};
+TNameCacheEntry sNameCache[64];
+} // namespace
+
+static JDrama::TNameRef* searchNameCached(const char* name)
+{
+	if (!SMS3DS_NameCache)
+		return JDrama::TNameRefGen::search<JDrama::TNameRef>(name);
+	JDrama::TNameRef* const root = JDrama::TNameRefGen::getInstance()->getRootNameRef();
+	const u16 key                = JDrama::TNameRef::calcKeyCode(name);
+	TNameCacheEntry& e           = sNameCache[key & 63];
+	SMS3DS_NameCacheStats[0]++;
+	if (e.root == root && e.gen == SMS3DS_NameTreeGen && e.key == key && strcmp(e.name, name) == 0) {
+		SMS3DS_NameCacheStats[1]++;
+		if (SMS3DS_NameCache == 2) {
+			SMS3DS_NameCacheStats[2]++;
+			if (JDrama::TNameRefGen::search<JDrama::TNameRef>(name) != e.result)
+				SMS3DS_NameCacheStats[3]++;
+		}
+		return e.result;
+	}
+	JDrama::TNameRef* const result = JDrama::TNameRefGen::search<JDrama::TNameRef>(name);
+	const size_t len               = strlen(name);
+	if (len < sizeof e.name) {
+		e.root   = root;
+		e.result = result;
+		e.gen    = SMS3DS_NameTreeGen;
+		e.key    = key;
+		memcpy(e.name, name, len + 1);
+		SMS3DS_NameCacheStats[4]++;
+	}
+	return result;
+}
+#endif
+
