+#if defined(__3DS__)
+// 3DS port: ReInitializeGX(); SMS_DrawInit(); as one state block (sms-pc-port patch 0031), each
+// register written once with the value the two leave it. The lights call the pair some 27 times a
+// frame on Delfino Plaza, and SMS_DrawInit rewrites much of what ReInitializeGX has just sent.
+// The texture loads of both go first, in their order (they set only the texture registers, which
+// the blocks do not touch); the paired-single setup and the texture cache regions come last, as
+// they did.
+extern "C" void SMS3DS_ReInitState();
+extern "C" void SMS3DS_ReInitTexture();
+extern "C" void SMS3DS_DrawInitState();
+extern "C" void GXPC_StateBlock(void** slot, void (*fn)(void), const char* name);
+static void ReInitAndDrawInitState()
+{
+	SMS3DS_ReInitState();
+	SMS3DS_DrawInitState();
+}
+void SMS3DS_ReInitAndDrawInit()
+{
+	SMS3DS_ZONE(8);
+	static void* block;
+	SMS3DS_ReInitTexture();
+	j3dSys.reinitTexture();
+	GXPC_StateBlock(&block, ReInitAndDrawInitState, "ReInitializeGX + SMS_DrawInit");
+	OSInitFastCast();
+	j3dSys.setTexCacheRegion(GX_TEXCACHE_32K);
+	SMS_ResetTexCacheRegion();
+}
+#endif
