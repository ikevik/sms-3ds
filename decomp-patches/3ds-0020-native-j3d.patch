--- /dev/null
+++ b/include/sms3ds_j3d.h
@@ -0,0 +1,41 @@
+// 3DS port (decomp patch 3ds-0020, native J3D stage 1, docs/native-j3d.md): J3D's material and
+// shape draws sent to the GX thread as one op each, with the values their GX calls would have
+// sent, instead of the calls. The GX thread (sms-pc-port patch 0035, gx_fifo.cpp) draws a shape
+// from what it compiled the first time, or replays the very commands the calls would have made.
+// Only in the draw buffers settings.txt names (native_j3d_buffers), while TDrawBufObj::perform
+// draws them (SMS3DS_J3DNative).
+#ifndef SMS3DS_J3D_H
+#define SMS3DS_J3D_H
+#if defined(__3DS__)
+#include <stdint.h>
+
+// What J3DShape::draw sends (pipeline 0: every matrix loaded by index), as values.
+struct SMS3DSJ3DShapeOp {
+	uint32_t shape;          // the J3DShape: the key
+	uint32_t vcdvat;         // its vertex-format list (host pointer, J3DShape::kVcdVatDLSize bytes)
+	uint32_t pos, nrm, col;  // J3DLoadArrayBasePtr's CP values for GX_VA_POS, NRM and CLR0
+	uint32_t drawMtx;        // GX_POS_MTX_ARRAY's base (host pointer; stride sizeof(Mtx))
+	uint32_t nrmMtx;         // GX_NRM_MTX_ARRAY's base (host pointer; stride sizeof(Mtx33))
+	uint32_t matA, matB;     // JRNLoadCurrentMtx's matrix-index registers (CP and XF)
+	uint32_t ngroups;
+	struct Group {
+		uint32_t list, size;  // the group's draw list (host pointer; 0: none)
+		uint16_t nslots;      // matrices loaded, slot by slot (0: none)
+		uint16_t idx[10];     // each slot's matrix index; 0xFFFF: skipped
+	} group[8];
+};
+
+extern "C" {
+// Set while a draw buffer settings.txt names is drawn: 1 natively, 2 natively checked against the
+// calls (the calls are made too, and the GX thread compares what each left).
+extern int SMS3DS_J3DNative;
+// The mode for the draw buffer called name (TDrawBufObj::perform).
+int SMS3DS_J3DBufferMode(const char* name);
+// Each returns 0 when it sent nothing (make the calls), 1 when it sent the op (skip them), 2 when
+// it sent it to be checked (make the calls, then SMS3DS_J3DEnd).
+int SMS3DS_J3DMat(const void* list, uint32_t size);
+int SMS3DS_J3DShape(const SMS3DSJ3DShapeOp* op);
+void SMS3DS_J3DEnd(void);
+}
+#endif
+#endif
