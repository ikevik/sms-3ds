@@ -225,8 +229,64 @@
 	J3DLoadArrayBasePtr(GX_VA_CLR0, j3dSys.getVtxCol());
 }
 
+#if defined(__3DS__)
+// 3DS port (decomp patch 3ds-0020, native J3D): the matrix groups the native op can express are
+// J3DShapeMtx and J3DShapeMtxMulti themselves (their loads go by index); told apart from the
+// other kinds (display-list loads, billboards) by their virtual tables.
+static const void* sms3dsVtable(const void* obj) { return *(const void* const*)obj; }
+static const J3DShapeMtx sms3dsSingleMtx(0);
+static const J3DShapeMtxMulti sms3dsMultiMtx(0, 0, nullptr);
+#endif
+
 void J3DShape::draw() const
 {
+#if defined(__3DS__)
+	// 3DS port: in a draw buffer drawn natively (SMS3DS_J3DNative), one op with the values the
+	// calls below would send, when every matrix is loaded by index (pipeline 0) and no normal is
+	// bump-mapped (NBT). The game-side state the calls set is set as they would.
+	int sms3dsNative = 0;
+	if (SMS3DS_J3DNative && (mFlags >> 2 & 3) == 0 && !mHasNBT && mMtxGroupNum <= 8) {
+		SMS3DSJ3DShapeOp op;
+		bool ok = true;
+		op.shape   = (uint32_t)(uintptr_t)this;
+		op.vcdvat  = (uint32_t)(uintptr_t)mVcdVatCmd;
+		op.pos     = OSCachedToPhysical(j3dSys.getVtxPos());
+		op.nrm     = OSCachedToPhysical(j3dSys.getVtxNrm());
+		op.col     = OSCachedToPhysical(j3dSys.getVtxCol());
+		op.drawMtx = (uint32_t)(uintptr_t)mDrawMatrices[*mCurrentViewNo];
+		op.nrmMtx  = (uint32_t)(uintptr_t)mNormMatrices[*mCurrentViewNo];
+		op.matA    = CP_MTX_REG_A(GX_PNMTX0, mCurrentTexMtx[0], mCurrentTexMtx[1], mCurrentTexMtx[2], mCurrentTexMtx[3]);
+		op.matB    = CP_MTX_REG_B(mCurrentTexMtx[4], mCurrentTexMtx[5], mCurrentTexMtx[6], mCurrentTexMtx[7]);
+		op.ngroups = mMtxGroupNum;
+		for (u16 i = 0; ok && i < mMtxGroupNum; ++i) {
+			SMS3DSJ3DShapeOp::Group& gr = op.group[i];
+			gr.list   = mDraws[i] ? (uint32_t)(uintptr_t)mDraws[i]->getDisplayList() : 0;
+			gr.size   = mDraws[i] ? mDraws[i]->getDisplayListSize() : 0;
+			gr.nslots = 0;
+			const J3DShapeMtx* m = mMatrices[i];
+			if (!m)
+				continue;
+			if (sms3dsVtable(m) == sms3dsVtable(&sms3dsSingleMtx)) {
+				gr.nslots = 1;
+				gr.idx[0] = m->getUseMtxIndex(0);
+			} else if (sms3dsVtable(m) == sms3dsVtable(&sms3dsMultiMtx) && m->getUseMtxNum() <= 10) {
+				gr.nslots = (uint16_t)m->getUseMtxNum();
+				for (u16 k = 0; k < gr.nslots; ++k)
+					gr.idx[k] = m->getUseMtxIndex(k);
+			} else {
+				ok = false;
+			}
+		}
+		if (ok)
+			sms3dsNative = SMS3DS_J3DShape(&op);
+		if (sms3dsNative == 1) {
+			J3DShapeMtx::currentPipeline = 0;
+			j3dSys.mCurrentDrawMtx = mDrawMatrices[*mCurrentViewNo];
+			j3dSys.mCurrentNormMtx = mNormMatrices[*mCurrentViewNo];
+			return;
+		}
+	}
+#endif
 	SMS3DS_GX_ORIGIN(SMS3DS_GX_J3D_VTX_FORMAT);
 	GXCallDisplayList(mVcdVatCmd, J3DShape::kVcdVatDLSize);
 
@@ -249,4 +309,8 @@
 		if (mDraws[i])
 			mDraws[i]->draw();
 	}
-}
+#if defined(__3DS__)
+	if (sms3dsNative == 2)
+		SMS3DS_J3DEnd();
+#endif
+}
