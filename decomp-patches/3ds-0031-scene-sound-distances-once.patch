 #include <MSound/MSSetSound.hpp>
+#if defined(__3DS__)
+// 3DS port (decomp patch 3ds-0031): sortMaxTrans ranks frameLoop's positions by their distance from
+// the camera, working out two distances at each step and the same ones again for the next position:
+// each one three of MSL's powf and a sqrtf, thousands a frame in Delfino Plaza. frameLoop's positions
+// are one array that nothing changes while it ranks them, and the camera stays where it is, so each
+// position's distance is worked out once, the first time it is wanted, and reused: the same values,
+// compared in the same order.
+// With draw_state_check = on (SMS3DS_RankCheck) each reused distance is worked out again and compared.
+#include <string.h>
+extern "C" int SMS3DS_RankCheck;
+extern "C" unsigned SMS3DS_RankStats[2];  // checked, differing
+static Vec* sms3ds_rankBase;  // frameLoop's positions while it ranks them, else null
+static u32 sms3ds_rankPass, sms3ds_rankStamp[256];
+static f32 sms3ds_rankDist[256];
+static f32 sms3ds_rankDistFromCamera(Vec* pos)
+{
+	const u32 i = (u32)(pos - sms3ds_rankBase);
+	if (sms3ds_rankStamp[i] != sms3ds_rankPass) {
+		sms3ds_rankStamp[i] = sms3ds_rankPass;
+		sms3ds_rankDist[i] = MSGMSound->getDistFromCamera(pos);
+	} else if (SMS3DS_RankCheck) {
+		const f32 d = MSGMSound->getDistFromCamera(pos);
+		SMS3DS_RankStats[0]++;
+		if (memcmp(&d, &sms3ds_rankDist[i], sizeof d) != 0)
+			SMS3DS_RankStats[1]++;
+	}
+	return sms3ds_rankDist[i];
+}
+#endif
 #include <MSound/MSoundBGM.hpp>
 
